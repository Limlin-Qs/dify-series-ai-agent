{
  "国铁时刻表": {
    "粒度": "车次事件（一站一行的到/发/经停记录）",
    "来源文件": "青岛站/青岛北站旅客列车季度时刻表 (.xls)",
    "解析器": "scripts/parse_rail_schedule.py",
    "字段": [
      {"字段": "车站", "类型": "string", "必填": true, "说明": "枢纽站名，如 青岛站/青岛北站"},
      {"字段": "季度", "类型": "string", "必填": true, "说明": "运行图季度，如 2026年一季度"},
      {"字段": "方向", "类型": "string", "必填": true, "说明": "出发/到达/经停，由到发时间推导"},
      {"字段": "车次", "类型": "string", "必填": true, "说明": "如 G6902、D6002"},
      {"字段": "始发站", "类型": "string", "必填": false},
      {"字段": "终到站", "类型": "string", "必填": false},
      {"字段": "到达时间", "类型": "time", "必填": false, "说明": "HH:MM，终到站为该车次时为空则按到达"},
      {"字段": "出发时间", "类型": "time", "必填": false, "说明": "HH:MM"},
      {"字段": "站台", "类型": "string", "必填": false},
      {"字段": "股道", "类型": "string", "必填": false},
      {"字段": "备注", "类型": "string", "必填": false, "说明": "如 高峰线"},
      {"字段": "日均发送", "类型": "count", "必填": false, "单位": "人", "说明": "仅部分季度提供"},
      {"字段": "日均到达", "类型": "count", "必填": false, "单位": "人", "说明": "仅部分季度提供"}
    ]
  },
  "航空专报": {
    "粒度": "枢纽日级（胶东机场每日一行）",
    "来源文件": "胶东机场数据专报 (.xlsx, Sheet2)",
    "解析器": "scripts/parse_airport_report.py",
    "字段": [
      {"字段": "日期", "类型": "date", "必填": true, "说明": "YYYY-MM-DD，源文件为 Excel 序列值"},
      {"字段": "航班到达架次", "类型": "count", "必填": true, "单位": "架次"},
      {"字段": "航班出发架次", "类型": "count", "必填": true, "单位": "架次"},
      {"字段": "航班合计架次", "类型": "count", "必填": true, "单位": "架次"},
      {"字段": "机场到达人次", "类型": "count", "必填": true, "单位": "人"},
      {"字段": "机场出发人次", "类型": "count", "必填": true, "单位": "人"},
      {"字段": "机场吞吐合计", "类型": "count", "必填": true, "单位": "人"},
      {"字段": "地铁进站人次", "类型": "count", "必填": false, "单位": "人"},
      {"字段": "地铁出站人次", "类型": "count", "必填": false, "单位": "人"},
      {"字段": "地铁合计人次", "类型": "count", "必填": false, "单位": "人"},
      {"字段": "地铁分担到达", "类型": "share", "必填": false},
      {"字段": "地铁分担出发", "类型": "share", "必填": false},
      {"字段": "地铁分担合计", "类型": "share", "必填": false},
      {"字段": "高峰到达时段", "类型": "string", "必填": false, "说明": "如 12-13"},
      {"字段": "高峰出发时段", "类型": "string", "必填": false},
      {"字段": "高峰到达航班架次", "类型": "count", "必填": false},
      {"字段": "高峰出发航班架次", "类型": "count", "必填": false},
      {"字段": "高峰到达人次", "类型": "count", "必填": false},
      {"字段": "高峰出发人次", "类型": "count", "必填": false},
      {"字段": "高峰地铁进站人次", "类型": "count", "必填": false},
      {"字段": "高峰地铁出站人次", "类型": "count", "必填": false},
      {"字段": "高峰地铁分担到达", "类型": "share", "必填": false},
      {"字段": "高峰地铁分担出发", "类型": "share", "必填": false},
      {"字段": "方式占比_地铁", "类型": "share", "必填": false},
      {"字段": "方式占比_巴士快线", "类型": "share", "必填": false},
      {"字段": "方式占比_出租车", "类型": "share", "必填": false},
      {"字段": "方式占比_网约车", "类型": "share", "必填": false},
      {"字段": "方式占比_私家车", "类型": "share", "必填": false},
      {"字段": "方式占比_高铁", "类型": "share", "必填": false},
      {"字段": "方式占比_公交车", "类型": "share", "必填": false},
      {"字段": "方式占比_其他", "类型": "share", "必填": false, "说明": "配平项，可能为负"},
      {"字段": "直达快车早间1", "类型": "string", "必填": false},
      {"字段": "直达快车早间2", "类型": "string", "必填": false},
      {"字段": "直达快车夜间1", "类型": "string", "必填": false},
      {"字段": "直达快车夜间2", "类型": "string", "必填": false},
      {"字段": "未覆盖早间出港架次", "类型": "count", "必填": false},
      {"字段": "未覆盖早间出港人数", "类型": "count", "必填": false},
      {"字段": "未覆盖夜间进港架次", "类型": "count", "必填": false},
      {"字段": "未覆盖夜间进港人数", "类型": "count", "必填": false}
    ],
    "占比组": ["方式占比_地铁", "方式占比_巴士快线", "方式占比_出租车", "方式占比_网约车", "方式占比_私家车", "方式占比_高铁", "方式占比_公交车", "方式占比_其他"]
  },
  "地铁客流": {
    "粒度": "车站日级（可选时段级）",
    "来源文件": "地铁进出站客流 (.csv/.xlsx)",
    "解析器": "scripts/parse_mode_template.py",
    "字段": [
      {"字段": "日期", "类型": "date", "必填": true},
      {"字段": "车站", "类型": "string", "必填": true, "别名": ["站点", "站名"]},
      {"字段": "线路", "类型": "string", "必填": true, "别名": ["线路名"]},
      {"字段": "进站客流", "类型": "count", "必填": true, "单位": "人次", "别名": ["进站", "进站量"]},
      {"字段": "出站客流", "类型": "count", "必填": true, "单位": "人次", "别名": ["出站", "出站量"]},
      {"字段": "换乘客流", "类型": "count", "必填": false, "单位": "人次"},
      {"字段": "时段", "类型": "string", "必填": false, "说明": "如 07-08；缺省为日级"}
    ]
  },
  "公交客流": {
    "粒度": "线路站点日级（可选时段级）",
    "来源文件": "公交刷卡/客流统计 (.csv/.xlsx)",
    "解析器": "scripts/parse_mode_template.py",
    "字段": [
      {"字段": "日期", "类型": "date", "必填": true},
      {"字段": "线路", "类型": "string", "必填": true, "别名": ["线路名", "公交线路"]},
      {"字段": "站点", "类型": "string", "必填": true, "别名": ["站名"]},
      {"字段": "方向", "类型": "string", "必填": false, "说明": "上行/下行"},
      {"字段": "上车人数", "类型": "count", "必填": true, "单位": "人次", "别名": ["上车量", "上客数"]},
      {"字段": "下车人数", "类型": "count", "必填": false, "单位": "人次", "别名": ["下车量", "下客数"]},
      {"字段": "时段", "类型": "string", "必填": false}
    ]
  },
  "P+R停车场": {
    "粒度": "停车场小时级或日级",
    "来源文件": "停车场占用数据 (.csv/.xlsx)",
    "解析器": "scripts/parse_mode_template.py",
    "字段": [
      {"字段": "日期", "类型": "date", "必填": true},
      {"字段": "停车场名称", "类型": "string", "必填": true, "别名": ["车场", "名称"]},
      {"字段": "枢纽", "类型": "string", "必填": true, "说明": "所服务的枢纽，如 青岛北站"},
      {"字段": "总泊位", "类型": "count", "必填": true, "单位": "个", "别名": ["泊位数", "车位数"]},
      {"字段": "占用泊位", "类型": "count", "必填": true, "单位": "个", "别名": ["占用车位"]},
      {"字段": "时段", "类型": "string", "必填": false}
    ]
  },
  "共享单车": {
    "粒度": "枢纽周边区域小时级或日级",
    "来源文件": "共享单车订单/潮汐数据 (.csv/.xlsx)",
    "解析器": "scripts/parse_mode_template.py",
    "字段": [
      {"字段": "日期", "类型": "date", "必填": true},
      {"字段": "区域", "类型": "string", "必填": true, "说明": "围栏或站点片区", "别名": ["片区", "围栏"]},
      {"字段": "枢纽", "类型": "string", "必填": true},
      {"字段": "借车数", "类型": "count", "必填": true, "单位": "次", "别名": ["借出数", "骑行发起"]},
      {"字段": "还车数", "类型": "count", "必填": true, "单位": "次", "别名": ["归还数"]},
      {"字段": "时段", "类型": "string", "必填": false}
    ]
  }
}
