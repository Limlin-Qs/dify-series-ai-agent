lassification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"def main(file) -> dict:\n        \n\n\n\n    return {\n        # 平台文件下载地址（Dify 后端加密生成的 HTTP 访问链接）\n        \"url\": file.url,\n        # 服务器本地文件路径（代码节点可直接读取）\n        \"local_path\": file.local_path,\n        # 原始文件名\n        \"filename\": file.filename,\n        # 文件扩展名（含点号，如 .xlsx）\n        \"extension\": file.extension,\n        # MIME 类型（用于标识文件格式）\n        \"mime_type\": file.mime_type,\n        # 文件大小（单位：字节）\n        \"size\": file.size,\n        # 文件类型枚举（如 document、image、audio、video）\n        \"type\": str(file.type),\n        # 文件传输方式（local_file 为本地上传，remote_url 为远程链接）\n        \"transfer_method\": str(file.transfer_method),\n        # 远程地址（仅当 transfer_method 为 remote_url 时有值，本地上传时为空）\n        \"remote_url\": file.remote_url,\n        # Base64 编码内容（仅当 transfer_method 为 b64 时有值，一般为空）\n        \"b64\": file.b64,\n    }","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],"selected":true,"payload__code_language":"python3","payload__variables":[{"variable":"file","id":"b4fec467-eb4f-4c99-82dc-d95a4e291c7e","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["bfe07060-0ac7-4f5e-bf48-ed3b76ad8935","upload_file","_idbe5642bb-3a30-43c9-995e-9dd8d7acf5dd"],"type":"file","is_constant":false,"value_selector":["bfe07060-0ac7-4f5e-bf48-ed3b76ad8935","upload_file"]}],"payload__outputs":{"url":{"type":"string"},"filename":{"type":"string"}}},"position":{"x":523.9808849108372,"y":48.66303672618892},"targetPosition":"left","sourcePosition":"right","positionAbsolute":{"x":523.9808849108372,"y":48.66303672618892},"width":194,"height":103,"selected":true},{"id":"1782874957308","type":"custom","data":{"type":"universe","title":"判断 - 是否进行格式修复","desc":"根据分支条件，判断执行哪个任务","config__input_ports":[{"id":"target","param_check_success":false,"param_input