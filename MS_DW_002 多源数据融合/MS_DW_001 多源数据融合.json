pe":"boolean","fieldProps":{"layout":"horizontal","colon":false},"itemProps":{"size":"small"},"defaultValue":false,"required":false,"tooltip":"模型能够收到前轮对话内容以丰富背景信息输入","isChatModeRemain":true,"onChangeCallbackKey":"online-llm-payload__use_history-onChange"},{"label":"上下文窗口大小","name":"payload__context_window_size","type":"slider","defaultValue":50,"required":false,"hide":false,"itemProps":{"min":1,"max":100}},{"label":"异常处理","name":"error_strategy","type":"error_handle","tooltip":"配置异常处理策略，当节点发生异常时触发"}],"config__input_shape":[{"variable":"query","variable_readonly":true,"type":"string","type_readonly":true,"variable_allow_clear":false,"id":"e57498e5-7242-4e6c-bd8e-6c93013289a9","defaultBooleanValue":false,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","sys","query","_ide1538b97-66aa-4896-a835-c491825fdaf2"],"type_readonly_initial":true}],"config__output_shape":[{"variable":"text","variable_readonly":true,"type":"string","type_readonly":true,"variable_allow_clear":false,"id":"878b7667-ea6c-448e-ac1a-689cf5d008a6"}],"name":"online-llm","classification":"basic-model","payload__kind":"OnlineLLM","payload__stream":true,"title_en":"OnlineLLM","config__can_run_by_single":true,"payload__variables":[{"variable":"query","variable_readonly":true,"type":"string","type_readonly":true,"variable_allow_clear":false,"id":"e57498e5-7242-4e6c-bd8e-6c93013289a9","defaultBooleanValue":false,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","sys","query","_ide1538b97-66aa-4896-a835-c491825fdaf2"],"type_readonly_initial":true,"is_constant":false,"value_selector":["sys","query"]}],"payload__version":2,"payload__vision_enable":false,"vision_param":{"var_value":[]},"payload__outputs":{"text":{"type":"string"}},"payload__prompt":{"system":"# 角色\n你是一个防汛物资查询助手，需要借助知识库查询得到的信息，帮助用户汇总或分析物资明细。\n# 任务\n1. 用户输入自然语言查询某一站点/部门的某类物资数量（\"XX站有多少XX\"）\n2. 用户查询某条线路/中心某类物资总量（\"X号线有多少XX\"\"物资后勤中心有多少XX\"）\n3. 用户查询低于安全阈值的物资（\"哪些站点防汛沙袋不足100个\"）\n你要按照查询检索知识库的结果生成对应的回复\n# 约束\n不回复防汛以外的问题，礼貌说明自己的功能边界","user":"用户提问{{#bb0a6651-0d0c-4ded-8791-0b00210121c6.sys.query._ide1538b97-66aa-4896-a835-c491825fdaf2#}}\n知识库查询结果{{#1793789835851.result#}}\n请根据以上内容，生成回复"},"payload__model_type":"online","about":"","payload__response_format":"text","payload__use_history":true,"payload__context_window_size":50,"errorMessage":["存在无效变量"],"selected":false,"model_resource":["129","149"],"payload__online_model_brand":"129","payload__online_model_id":"149","payload__model_conf":{},"payload__audio_variable":{},"payload__video_variable":{},"payload__vision_variable":{},"isVisionSwitchCanUse":false,"payload__prompt.system":"# 角色\n你是一个防汛物资查询助手，需要借助知识库查询得到的信息，帮助用户汇总或分析物资明细。\n# 任务\n1. 用户输入自然语言查询某一站点/部门的某类物资数量（\"XX站有多少XX\"）\n2. 用户查询某条线路/中心某类物资总量（\"X号线有多少XX\"\"物资后勤中心有多少XX\"）\n3. 用户查询低于安全阈值的物资（\"哪些站点防汛沙袋不足100个\"）\n你要按照查询检索知识库的结果生成对应的回复\n# 约束\n不回复防汛以外的问题，礼貌说明自己的功能边界","payload__prompt.user":"用户提问{{#bb0a6651-0d0c-4ded-8791-0b00210121c6.sys.query._ide1538b97-66aa-4896-a835-c491825fdaf2#}}\n知识库查询结果{{#1793789835851.result#}}\n请根据以上内容，生成回复"},"position":{"x":1131.957060347748,"y":341.79892643069104},"targetPosition":"left","sourcePosition":"right","positionAbsolute":{"x":1131.957060347748,"y":341.79892643069104},"width":195,"height":146,"selected":false},{"id":"1793796512258","type":"custom","data":{"type":"universe","title":"数据清洗与校验逻辑 (代码节点 A 核心代码)","desc":"嵌入自定义的 Python ，可作为自定义方法级组件扩展。","config__input_ports":[{"id":"target"}],"config__output_ports":[{"id":"source"}],"config__parameters":[{"name":"config__input_shape","type":"config__input_shape","label":"输入参数","effects":"","hide":false},{"name":"config__output_shape","type":"config__output_shape","label":"输出参数","effects":"","min":1,"max":1,"hide":false},{"name":"config__input_ports","type":"config__input_ports","label":"输入端点","effects":"","tooltip":"将输入变量格式化解析并输出，提取期望的字段","hide":true},{"name":"payload__code","type":"code","label":"Code","required":true}],"config__input_shape":[{"variable":"arg1","id":"f66a41a8-0b67-4de7-9f93-e2ff2c91c334","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","concert","_id8f10c2d1-bd92-4764-ac20-ddb2e84d8601"],"type":"string","type_readonly_initial":true},{"variable":"arg2","id":"d75043d7-8312-4c11-b645-5fb5e4bb5745","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","usr_data","_id2618f956-2bb7-470c-b413-7193946ecaf1"],"type_readonly_initial":false,"type":"string"}],"config__output_shape":[{"id":"3d048a53-b4c8-42ee-835f-b6ba24833144","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"type":"string","variable_channel":"","constant_value":"","variable":"data_url"}],"name":"code","classification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"import pandas as pd\nfrom datetime import datetime\nimport re\n\ndef main(args: dict) -> dict:\n    # 1. 加载数据 (假设 input_data 是列表格式的字典或已解析的 DataFrame)\n    # 这里假设从上游传入的是 DataFrame 对象或列表\n    df = pd.DataFrame(args.get('raw_data')) # raw_data 需由文件读取步骤传入\n    \n    # 基础数据清洗\n    df['加分分值'] = pd.to_numeric(df['加分分值'], errors='coerce')\n    df['发生日期'] = pd.to_datetime(df['发生日期'], errors='coerce')\n    \n    # 定义有效范围\n    VALID_IDS = set([f'JX{str(i).zfill(4)}' for i in range(1001, 1018)]) # JX1001 ~ JX1017\n    VALID_CATEGORIES = {'故障抢修', '隐患排查', '技术改进', '带教培训', '加班支援'}\n    START_DATE = pd.Timestamp('2026-10-01')\n    END_DATE = pd.Timestamp('2026-10-31')\n    MAX_SINGLE_SCORE = 5.0\n    MAX_MONTHLY_SCORE = 15.0\n    BASE_SCORE = 85.0\n    \n    invalid_records = []\n    valid_records = []\n    \n    # 用于检测重复记录：Key = (工号，类别，日期) -> 保留第一行\n    seen_keys = {}\n    \n    # 遍历每一行进行校验 (保持原始顺序以便记录行号)\n    # 假设原始数据中有索引列，这里模拟 row_num\n    df['原行号'] = df.index + 1 \n    \n    for idx, row in df.iterrows():\n        row_num = row['原行号']\n        worker_id = str(row['工号']).strip()\n        name = row['姓名']\n        category = row['加分项类别']\n        score = row['加分分值']\n        date_val = row['发生日期']\n        \n        reason = None\n        \n        # 校验 1: 工号有效性\n        if worker_id not in VALID_IDS:\n            reason = \"工号不在花名册\"\n        # 校验 2: 类别有效性\n        elif category not in VALID_CATEGORIES:\n            reason = f\"类别不在加分清单 ({category})\"\n        # 校验 3: 日期有效性\n        elif date_val is pd.NaT or date_val < START_DATE or date_val > END_DATE:\n            reason = f\"发生日期越界 ({row['发生日期']})\"\n        # 校验 4: 分值有效性 (非数字、0、负数)\n        elif pd.isna(score) or score <= 0:\n            reason = f\"分值无效 ({score})\"\n        # 校验 5: 单项上限\n        elif score > MAX_SINGLE_SCORE:\n            reason = f\"单项加分超上限 ({score} > 5)\"\n        # 校验 6: 重复记录\n        else:\n            key = (worker_id, category, date_val)\n            if key in seen_keys:\n                reason = \"同一工号+类别+日期重复提报\"\n            else:\n                seen_keys[key] = True\n        \n        if reason:\n            invalid_records.append({\n                \"CSV行号\": row_num,\n                \"工号\": worker_id,\n                \"姓名\": name,\n                \"类别\": category,\n                \"分值\": score if not pd.isna(score) else row['加分分值'], # 保持原始显示\n                \"日期\": str(row['发生日期']) if not pd.isna(date_val) else row['发生日期'],\n                \"剔除原因\": reason\n            })\n        else:\n            valid_records.append({\n                \"工号\": worker_id,\n                \"姓名\": name,\n                \"类别\": category,\n                \"分值\": score,\n                \"日期\": date_val\n            })\n            \n    # 2. 绩效计算\n    # 按工号聚合\n    emp_map = {} # key: 工号, value: {'name': str, 'total_add': float, 'raw_records': list}\n    \n    # 初始化所有员工 (JX1001-JX1017)\n    for i in range(1001, 1018):\n        wid = f'JX{i}'\n        emp_map[wid] = {'name': '', 'total_add': 0.0, 'raw_count': 0, 'records': []}\n        \n    for rec in valid_records:\n        wid = rec['工号']\n        if wid in emp_map:\n            emp_map[wid]['name'] = rec['姓名'] # 更新姓名\n            emp_map[wid]['total_add'] += rec['分值']\n            emp_map[wid]['raw_count'] += 1\n            emp_map[wid]['records'].append(rec)\n            \n    # 计算总分、等级、封顶\n    stats = []\n    capped_list = []\n    zero_add_list = []\n    \n    for wid, data in emp_map.items():\n        raw_add = data['total_add']\n        \n        # 封顶逻辑\n        final_add = min(raw_add, MAX_MONTHLY_SCORE)\n        is_capped = raw_add > MAX_MONTHLY_SCORE\n        \n        total_score = BASE_SCORE + final_add\n        \n        # 等级判定\n        if total_score >= 95:\n            level = \"优秀\"\n        elif total_score >= 90:\n            level = \"良好\"\n        elif total_score >= 85:\n            level = \"合格\"\n        else:\n            level = \"不合格\"\n            \n        if is_capped:\n            capped_list.append({\"工号\": wid, \"姓名\": data['name'], \"原始加分\": raw_add, \"封顶后\": final_add})\n            \n        if final_add == 0:\n            zero_add_list.append(f\"{data['name']} ({wid})\")\n            \n        stats.append({\n            \"工号\": wid,\n            \"姓名\": data['name'],\n            \"原始加分\": raw_add,\n            \"最终加分\": final_add,\n            \"总分\": total_score,\n            \"等级\": level,\n            \"有效记录数\": data['raw_count']\n        })\n        \n    # 3. 排序 (总分降序，同分工号升序)\n    stats.sort(key=lambda x: (-x['总分'], x['工号']))\n    \n    # 计算排名\n    for rank, item in enumerate(stats, 1):\n        item['排名'] = rank\n        \n    # 4. 汇总统计\n    total_emp = len(emp_map)\n    total_raw = len(df)\n    total_valid = len(valid_records)\n    total_invalid = len(invalid_records)\n    \n    total_scores = [x['总分'] for x in stats]\n    avg_score = sum(total_scores) / total_emp if total_emp > 0 else 0.0\n    max_score_item = stats[0]\n    min_score_item = stats[-1]\n    \n    # 等级分布\n    grade_dist = {'优秀': 0, '良好': 0, '合格': 0, '不合格': 0}\n    for item in stats:\n        grade_dist[item['等级']] += 1\n        \n    # 构造输出\n    result = {\n        \"invalid_records\": invalid_records,\n        \"employee_stats\": stats,\n        \"summary\": {\n            \"start_date\": \"2026-10-01\",\n            \"end_date\": \"2026-10-31\",\n            \"total_emp\": total_emp,\n            \"total_raw\": total_raw,\n            \"total_valid\": total_valid,\n            \"total_invalid\": total_invalid,\n            \"avg_score\": round(avg_score, 2),\n            \"max_score_name\": max_score_item['姓名'],\n            \"max_score_val\": max_score_item['总分'],\n            \"min_score_name\": min_score_item['姓名'],\n            \"min_score_val\": min_score_item['总分'],\n            \"grade_dist\": grade_dist,\n            \"top_5\": stats[:5],\n            \"capped_list\": capped_list,\n            \"zero_add_list\": zero_add_list\n        }\n    }\n    \n    return result","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],"selected":false,"payload__code_language":"python3","payload__variables":[{"variable":"arg1","id":"f66a41a8-0b67-4de7-9f93-e2ff2c91c334","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","concert","_id8f10c2d1-bd92-4764-ac20-ddb2e84d8601"],"type":"string","type_readonly_initial":true,"is_constant":false,"value_selector":["bb0a6651-0d0c-4ded-8791-0b00210121c6","concert"]},{"variable":"arg2","id":"d75043d7-8312-4c11-b645-5fb5e4bb5745","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["bb0a6651-0d0c-4ded-8791-0b00210121c6","usr_data","_id2618f956-2bb7-470c-b413-7193946ecaf1"],"type_readonly_initial":false,"type":"string","is_constant":false,"value_selector":["bb0a6651-0d0c-4ded-8791-0b00210121c6","usr_data"]}],"payload__outputs":{"data_ur