etPosition":"left","sourcePosition":"right","positionAbsolute":{"x":1980,"y":140},"width":194,"height":103,"selected":true},{"id":"2a2196df-7ecb-5083-8f74-5e0af2c99059","type":"custom","data":{"type":"universe","title":"查询结果标准化","desc":"嵌入自定义的 Python ，可作为自定义方法级组件扩展。","config__input_ports":[{"id":"target"}],"config__output_ports":[{"id":"source"}],"config__parameters":[{"name":"config__input_shape","type":"config__input_shape","label":"输入参数","effects":"","hide":false},{"name":"config__output_shape","type":"config__output_shape","label":"输出参数","effects":"","min":1,"max":1,"hide":false},{"name":"config__input_ports","type":"config__input_ports","label":"输入端点","effects":"","tooltip":"将输入变量格式化解析并输出，提取期望的字段","hide":true},{"name":"payload__code","type":"code","label":"Code","required":true}],"config__input_shape":[{"id":"91741742-5654-52fd-82cc-0c9a63c86c78","variable":"status_code","type":"number","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["f88c3fbe-fc79-5195-bc36-1126b2a28591","status_code","_idee7cc865-4f79-58a1-bd2f-1142f48086d1"]},{"id":"884cd7ab-193c-5aab-a908-d90dd230b98a","variable":"content","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["f88c3fbe-fc79-5195-bc36-1126b2a28591","content","_idd5952901-a426-5d22-8113-270f892f9560"]}],"config__output_shape":[{"id":"0363c5b4-6b01-5143-a529-82146fec4706","variable":"result","type":"dict"}],"name":"code","classification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"def main(status_code: float, content: str) -> dict:\n    import json\n    import math\n\n    fields = ['line_id', 'capacity_per_train', 'target_rate_up_morning', 'target_rate_up_evening', 'target_rate_down_morning', 'target_rate_down_evening', 'target_rate_off_peak', 'target_rate_weekend', 'flow_percentile', '_id']\n\n    def fail(code, message):\n        return {\"result\": {\"success\": False, \"action\": \"query\", \"code\": code,\n                \"message\": message, \"data\": [], \"count\": 0, \"verified\": False}}\n\n    if type(status_code) not in (int, float) or not 200 <= status_code < 300:\n        return fail(\"QUERY_HTTP_ERROR\", \"查询HTTP请求失败\")\n    try:\n        obj = json.loads(content)\n    except (ValueError, TypeError, RecursionError):\n        return fail(\"QUERY_INVALID_RESPONSE\", \"查询响应不是合法JSON\")\n    if not isinstance(obj, dict):\n        return fail(\"QUERY_INVALID_RESPONSE\", \"查询响应必须是对象\")\n    if (\"code\" in obj and (type(obj[\"code\"]) is not int or obj[\"code\"] != 200)) or (\"success\" in obj and obj[\"success\"] is not True) or (\"result\" in obj and obj[\"result\"] != \"success\"):\n        return fail(\"QUERY_FAILED\", \"查询接口返回业务失败\")\n    records = obj.get(\"data\")\n    if not isinstance(records, list):\n        return fail(\"QUERY_INVALID_RESPONSE\", \"查询响应缺少data数组，不能视为空表\")\n    total, page, size, pages = (obj.get(key) for key in (\"total\", \"page\", \"per_page\", \"total_pages\"))\n    if (type(total) is not int or total < 0 or type(page) is not int or page != 1\n            or type(size) is not int or size <= 0 or type(pages) is not int or pages < 0):\n        return fail(\"QUERY_INVALID_RESPONSE\", \"查询分页元数据缺失或不合法\")\n    if total != len(records) or len(records) > size or pages > 1:\n        return fail(\"QUERY_INCOMPLETE\", \"查询结果未覆盖全表，请调整分页后重试\")\n    if (records and pages != 1) or (not records and pages not in (0, 1)):\n        return fail(\"QUERY_INVALID_RESPONSE\", \"查询分页数量不一致\")\n    rows, ids, lines = [], set(), set()\n    for record in records:\n        if not isinstance(record, dict) or not set(fields).issubset(record):\n            return fail(\"QUERY_INVALID_ROW\", \"配置记录缺少必要字段\")\n        rid, line, capacity = record[\"_id\"], record[\"line_id\"], record[\"capacity_per_train\"]\n        if not isinstance(rid, str) or not rid.strip() or rid != rid.strip():\n            return fail(\"QUERY_INVALID_ROW\", \"配置记录编号不合法\")\n        if type(line) is not int or line <= 0 or type(capacity) is not int or capacity <= 0:\n            return fail(\"QUERY_INVALID_ROW\", \"线路编号或每列车运力不合法\")\n        for key in list(fields)[2:9]:\n            value = record[key]\n            if type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 1:\n                return fail(\"QUERY_INVALID_ROW\", \"配置比例或分位数不合法\")\n        if rid in ids or line in lines:\n            return fail(\"QUERY_DUPLICATE_ROW\", \"查询结果存在重复记录或线路\")\n        ids.add(rid)\n        lines.add(line)\n        rows.append({wire: record[wire] for wire in fields})\n    return {\"result\": {\"success\": True, \"action\": \"query\", \"code\": \"OK\",\n            \"message\": \"查询成功\", \"data\": rows, \"count\": len(rows), \"verified\": True}}\n","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],"selected":false,"payload__code_language":"python3","payload__variables":[{"id":"91741742-5654-52fd-82cc-0c9a63c86c78","variable":"status_code","type":"number","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["f88c3fbe-fc79-5195-bc36-1126b2a28591","status_code","_idee7cc865-4f79-58a1-bd2f-1142f48086d1"],"is_constant":false,"value_selector":["f88c3fbe-fc79-5195-bc36-1126b2a28591","status_code"]},{"id":"884cd7ab-193c-5aab-a908-d90dd230b98a","variable":"content","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["f88c3fbe-fc79-5195-bc36-1126b2a28591","content","_idd5952901-a426-5d22-8113-270f892f9560"],"is_constant":false,"value_selector":["f88c3fbe-fc79-5195-bc36-1126b2a28591","content"]}],"payload__outputs":{"result":{"type":"dict"}}},"position":{"x":2260,"y":-180},"targetPosition":"left","sourcePosition":"right","positionAbsolute":{"x":2260,"y":-180},"width":194,"height":1