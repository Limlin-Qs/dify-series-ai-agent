a13f-9b29a786f0aa","variable":"content","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["1789545573332","content","_idc6986467-6f96-4293-a724-7503aa509198"]},{"id":"95476947-d6b4-5048-a6c6-ceda630021a9","variable":"action","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["1789545594879","action","_id6a4901d7-7741-58cd-b979-7cb5b0247d4e"]}],"config__output_shape":[{"id":"465d7013-79de-54e3-818e-f1d074c548b0","variable":"ok","type":"boolean"},{"id":"354dd64f-0dd1-52c0-82a1-6fe0aaf8e99a","variable":"authorization","type":"string"},{"id":"a4abeeef-2c0b-5dd0-9770-15148b1d7e33","variable":"result","type":"dict"}],"name":"code","classification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"def main(status_code: float, content: str, action: str) -> dict:\n    import json\n\n    def fail(code, message):\n        return {\"ok\": False, \"authorization\": \"\", \"result\": {\n            \"success\": False, \"action\": action, \"code\": code, \"message\": message,\n            \"data\": [], \"count\": 0, \"verified\": False}}\n\n    if type(status_code) not in (int, float) or not 200 <= status_code < 300:\n        return fail(\"LOGIN_HTTP_ERROR\", \"登录HTTP请求失败，未执行业务请求\")\n    try:\n        obj = json.loads(content)\n    except (ValueError, TypeError, RecursionError):\n        return fail(\"LOGIN_INVALID_RESPONSE\", \"登录响应不是合法JSON对象\")\n    if not isinstance(obj, dict) or obj.get(\"result\") != \"success\":\n        return fail(\"LOGIN_FAILED\", \"登录未返回success，未执行业务请求\")\n    token = obj.get(\"data\")\n    if not isinstance(token, str) or not token or any(c.isspace() or ord(c) < 33 or ord(c) > 126 for c in token):\n        return fail(\"LOGIN_INVALID_TOKEN\", \"登录响应缺少有效Token\")\n    return {\"ok\": True, \"authorization\": \"Bearer \" + token, \"result\": {}}\n","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],"selected":false,"payload__code_language":"python3","payload__variables":[{"id":"21cfef41-4db7-5bfe-8e13-46bc857f21a4","variable":"status_code","type":"number","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["1789545573332","status_code","_id318c0250-8e87-4323-b033-a398fb36d519"],"is_constant":false,"value_selector":["1789545573332","status_code"]},{"id":"c3db1bb7-f804-5fdb-a13f-9b29a786f0aa","variable":"content","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["1789545573332","content","_idc6986467-6f96-4293-a724-7503aa509198"],"is_constant":false,"value_selector":["1789545573332","content"]},{"id":"95476947-d6b4-5048-a6c6-ceda630021a9","variable":"action","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["1789545594879","action","_id6a4901d7-7741-58cd-b979-7cb5b0247d4e"],"is_constant":false,"value_selector":["1789545594879","action"]}],"payload__outputs":{"ok":{"type":"boolean"},"authorization":{"type":"string"},"result":{"type":"dict"}}},"position":{"x":1130,"y":0},"targetPosition":"left","sourcePosition":"right","positionAbsolute":{"x":1130,"y":0},"width":194,"height":103,"selected":false},{"id":"f6d215f1-9d12-5fda-ae31-8fb19e252711","type":"custom","data":{"type":"universe","title":"登录成功？","desc":"根据分支条件，判断执行哪个任务","config__input_ports":[{"id":"target"}],"config__output_ports":[{"id":"true","label":"IF","cond":"def main(arg1, arg2):\n  if arg1 > arg2:\n     return True   #如果为True走if路线","conditions":[{"variable_name":"ok","variable_type":"boolean","comparison_operator":"=","value_type":"const","const_value":true,"selector_value":[]}],"logical_operator":"and","chosen":false,"selected":false},{"id":"false","label":"ELSE"}],"config__paramet