{"id":"58b07c61-a0f2-4eb7-a19a-fbd196f18165","name":"运输生产子智能体-运输计划配置维护","description":"用来维护配置表的增删改查","icon":null,"icon_background":null,"categories":[],"apptype":"agent","tags":[],"clusters":[],"graph":{"nodes":[{"id":"df054179-ecfe-450f-9887-19213fd7259c","type":"custom","data":{"type":"start","title":"开始","desc":"流程的起始节点","payload__kind":"__start__","variables":[],"config__input_ports":[],"config__output_shape":[{"variable":"user_id","type":"string","variable_category":"sys","id":"0304f81c-5007-4150-a3e4-95050992b139"},{"variable":"app_id","type":"string","variable_category":"sys","id":"de050cd2-da59-4cfb-a89b-6390d9f0b7ec"},{"variable":"action","label":"动作（默认query）","type":"string","max_length":200,"required":false,"options":[],"id":"3889e860-d471-4635-879a-165e18ed3b8d"},{"variable":"data","label":"更新数据（JSON字符串）","type":"string","max_length":2000000,"required":false,"options":[],"id":"de74ead3-e45c-497c-9857-27d92294e7fb"}],"config__output_ports":[{"id":"source"}],"config__parameters":[{"name":"config__output_shape","type":"config__output_shape","label":"参数","tooltip":"定义工作流需要的输入参数，可以选择多种格式"}],"name":"start","selected":false,"payload__variables":[{"variable":"action","label":"动作（默认query）","type":"string","max_length":200,"required":false,"options":[],"id":"3889e860-d471-4635-879a-165e18ed3b8d"},{"variable":"data","label":"更新数据（JSON字符串）","type":"string","max_length":2000000,"required":false,"options":[],"id":"de74ead3-e45c-497c-9857-27d92294e7fb"}],"errorMessage":[]},"position":{"x":0,"y":0},"targetPosition":"left","sourcePosition":"right","positionAbsolute":{"x":0,"y":0},"width":194,"height":189,"selected":false},{"id":"1789545594879","type":"custom","data":{"type":"universe","title":"校验动作与更新数据","desc":"嵌入自定义的 Python ，可作为自定义方法级组件扩展。","config__input_ports":[{"id":"target"}],"config__output_ports":[{"id":"source"}],"config__parameters":[{"name":"config__input_shape","type":"config__input_shape","label":"输入参数","effects":"","hide":false},{"name":"config__output_shape","type":"config__output_shape","label":"输出参数","effects":"","min":1,"max":1,"hide":false},{"name":"config__input_ports","type":"config__input_ports","label":"输入端点","effects":"","tooltip":"将输入变量格式化解析并输出，提取期望的字段","hide":true},{"name":"payload__code","type":"code","label":"Code","required":true}],"config__input_shape":[{"id":"e9de9969-885d-5bd2-8c28-c178e6f6e5a3","variable":"action","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["df054179-ecfe-450f-9887-19213fd7259c","action","_id3889e860-d471-4635-879a-165e18ed3b8d"]},{"id":"db6ac5fb-8826-5f01-8b98-052f8b67da6d","variable":"data","type":"string","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"readonly":false,"variable_channel":["df054179-ecfe-450f-9887-19213fd7259c","data","_idde74ead3-e45c-497c-9857-27d92294e7fb"]}],"config__output_shape":[{"id":"5a011709-b886-567c-8bc0-700e23523fe2","variable":"ok","type":"boolean"},{"id":"6a4901d7-7741-58cd-b979-7cb5b0247d4e","variable":"action","type":"string"},{"id":"3932df28-82fa-50cd-9551-e98e7ea11675","variable":"is_query","type":"boolean"},{"id":"73c0d36c-b7a3-50c4-9368-2b213a8c273c","variable":"body","type":"dict"},{"id":"eb38e8b6-1748-51f5-8555-00b393b2c2f7","variable":"new_rows","type":"array[dict]"},{"id":"18402391-98b9-5a30-a5ce-efe9e7e6193f","variable":"result","type":"dict"}],"name":"code","classification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"def main(action: str, data: str) -> dict:\n    import json\n    import math\n\n    fields = ['line_id', 'capacity_per_train', 'target_rate_up_morning', 'target_rate_up_evening', 'target_rate_down_morning', 'target_rate_down_evening', 'target_rate_off_peak', 'target_rate_weekend', 'flow_percentile', '_id']\n    normalized = \"\"\n\n    def fail(message):\n        return {\"ok\": False, \"action\": normalized, \"is_query\": False, \"body\": {},\n                \"new_rows\": [], \"result\": {\"success\": False, \"action\": normalized,\n                \"code\": \"INVALID_INPUT\", \"message\": message, \"data\": [],\n                \"count\": 0, \"verified\": False}}\n\n    def unique_pairs(pairs):\n        obj = {}\n        for key, value in pairs:\n            if key in obj:\n                raise ValueError(\"JSON含重复字段：\" + key)\n            obj[key] = value\n        return obj\n\n    def convert(row):\n        if not isinstance(row, dict) or set(row) != set(fields):\n            raise ValueError(\"old_data和new_data必须各自包含全部10个接口字段，不允许额外字段\")\n        for key in (\"line_id\", \"capacity_per_train\"):\n            if type(row[key]) is not int or row[key] <= 0:\n                raise ValueError(key + \"必须是正整数\")\n        for key in list(fields)[2:9]:\n            value = row[key]\n            if type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 1:\n                raise ValueError(key + \"必须是0至1之间的有限数值\")\n        rid = row[\"_id\"]\n        if not isinstance(rid, str) or not rid.strip() or rid != rid.strip():\n            raise ValueError(\"记录编号必须是非空且无首尾空白的字符串\")\n        return dict(row)\n\n    try:\n        if action is None:\n            action = \"\"\n        if not isinstance(action, str):\n            return fail(\"action必须是字符串\")\n        normalized = action.strip().lower() or \"query\"\n        if normalized == \"查询\":\n            normalized = \"query\"\n        elif normalized == \"更新\":\n            normalized = \"update\"\n        if normalized not in (\"query\", \"update\"):\n            return fail(\"仅支持query/查询或update/更新；不支持新增、删除\")\n        if data is None:\n            data = \"\"\n        if not isinstance(data, str):\n            return fail(\"data必须是JSON字符串\")\n        obj = json.loads(data, object_pairs_hook=unique_pairs) if data.strip() else {}\n        if not isinstance(obj, dict):\n            return fail(\"data必须解析为对象\")\n        if normalized == \"query\":\n            if obj:\n                return fail(\"查询的data应为空或{}，不会忽略更新数据或筛选条件\")\n            return {\"ok\": True, \"action\": \"query\", \"is_query\": True, \"body\": {},\n                    \"new_rows\": [], \"result\": {}}\n        if set(obj) != {\"add_items\", \"delete_items\", \"update_items\"}:\n            return fail(\"更新data必须包含add_items、delete_items、update_items\")\n        if obj[\"add_items\"] != [] or obj[\"delete_items\"] != []:\n            return fail(\"不支持新增或删除，add_items和delete_items必须为空数组\")\n        if not isinstance(obj[\"update_items\"], list) or not obj[\"update_items\"]:\n            return fail(\"update_items必须是非空数组\")\n        items, rows, ids, lines = [], [], set(), set()\n        for item in obj[\"update_items\"]:\n            if not isinstance(item, dict) or set(item) != {\"old_data\", \"new_data\"}:\n                return fail(\"每个更新项必须只包含old_data和new_data\")\n            old, new = convert(item[\"old_data\"]), convert(item[\"new_data\"])\n            if old[\"_id\"] != new[\"_id\"] or old[\"line_id\"] != new[\"line_id\"]:\n                return fail(\"记录编号和线路编号不可修改\")\n            if old[\"_id\"] in ids or old[\"line_id\"] in lines:\n                return fail(\"同一批更新不能包含重复记录或重复线路\")\n            if old == new:\n                return fail(\"更新项的新配置与原配置相同\")\n            ids.add(old[\"_id\"])\n            lines.add(old[\"line_id\"])\n            items.append({\"old_data\": old, \"new_data\": new})\n            rows.append(new)\n        body = {\"add_items\": [], \"delete_items\": [], \"update_items\": items}\n        return {\"ok\": True, \"action\": \"update\", \"is_query\": False,\n                \"body\": body, \"new_rows\": rows, \"result\": {}}\n    except (ValueError, TypeError, RecursionError, OverflowError) as exc:\n        return fail(str(exc) if not isinstance(exc, json.JSONDecodeError) else \"data不是合法JSON\")\n","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],