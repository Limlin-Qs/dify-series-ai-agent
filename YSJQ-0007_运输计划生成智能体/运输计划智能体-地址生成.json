sage","_ide39a5415-9fc7-5be6-8b72-cf05fe5af78d"]}]}],"config__output_ports":[{"id":"source"}],"config__parameters":[{"name":"config__input_shape","type":"config__input_shape","label":"输入参数","effects":"","hide":false},{"name":"config__output_shape","type":"config__output_shape","label":"输出参数","effects":"","min":1,"max":1,"hide":false},{"name":"config__input_ports","type":"config__input_ports","label":"输入端点","effects":"","tooltip":"将输入变量格式化解析并输出，提取期望的字段","hide":true},{"name":"payload__code","type":"code","label":"Code","required":true}],"config__input_shape":[{"variable":"plan_type","id":"874f7977-0405-506f-ba66-e082357b5cce","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_type","_id473e5f11-818c-52bc-87be-f02ed97ef2dd"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_type"]},{"variable":"plan_param","id":"d07565fa-8e92-5c53-a8de-2c5c0f6c0557","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_param","_idb2806c0a-d5c9-5e38-b56b-848b670d644f"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_param"]},{"variable":"start_date","id":"44429d35-a612-5071-9112-43a3bc12fe3b","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","start_date","_id7db670d9-ca9c-57b4-b3ce-5bf225fd51d8"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","start_date"]},{"variable":"end_date","id":"985c8e0f-dbd2-5bf3-93d2-df235f41aa72","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","end_date","_id842c602f-80fb-53c1-9260-121b96c9af71"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","end_date"]},{"variable":"process_text","id":"6c02bea7-2f99-5303-8c90-8a97b047bc7e","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","process_text","_id872cb4de-7a52-5862-acfb-b0aadf057f49"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","process_text"]},{"variable":"is_valid","id":"7b1fd07e-bdb1-57b6-83c2-ff165efed6f7","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"boolean","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","is_valid","_id90de09db-7960-5606-be24-ad5e1aeec33d"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","is_valid"]},{"variable":"error_message","id":"c6f74269-280e-50c8-bbeb-1f468fd47407","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","error_message","_ide39a5415-9fc7-5be6-8b72-cf05fe5af78d"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","error_message"]}],"config__output_shape":[{"id":"0c58dbeb-c9e1-5a85-b315-b7e1cc98fc5e","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"answer","type":"string","variable_channel":"","constant_value":""},{"id":"7d84fbd7-5b41-52b3-941a-064ba835b2b4","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"url","type":"string","variable_channel":"","constant_value":""},{"id":"8db45481-5c1f-591f-a983-6e3ff079b360","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"plan_type","type":"string","variable_channel":"","constant_value":""},{"id":"5a066025-ffeb-567b-a266-82099160f8c4","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"plan_param","type":"string","variable_channel":"","constant_value":""},{"id":"d964bb0e-6ff8-5d16-9b8e-25f4e8b1585f","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"start_date","type":"string","variable_channel":"","constant_value":""},{"id":"a783c7d8-341f-5b43-be80-677d13d517b0","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"end_date","type":"string","variable_channel":"","constant_value":""},{"id":"d8d96783-26c0-578d-bcc9-d91ae3b4600f","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"workflow_status","type":"string","variable_channel":"","constant_value":""},{"id":"a2b4c34e-6c29-5c35-a23b-d105dd689ab5","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":false,"readonly":false,"variable":"error_msg","type":"string","variable_channel":"","constant_value":""}],"name":"code","classification":"fundamental-component","payload__kind":"Code","config__can_run_by_single":true,"payload__code":"def main(\n    plan_type: str,\n    plan_param: str,\n    start_date: str,\n    end_date: str,\n    process_text: str,\n    is_valid: bool,\n    error_message: str\n) -> dict:\n    import calendar\n    import re\n    from datetime import date\n    from urllib.parse import urlencode\n\n    min_date = date(2023, 1, 1)\n    max_date = date(2026, 12, 31)\n\n    def failure(message):\n        return {\n            \"answer\": f\"无法生成运输计划地址：{message}\",\n            \"url\": \"\",\n            \"plan_type\": \"\",\n            \"plan_param\": \"\",\n            \"start_date\": \"\",\n            \"end_date\": \"\",\n            \"workflow_status\": \"失败\",\n            \"error_msg\": message\n        }\n\n    def parse_iso(value, field_name):\n        try:\n            return date.fromisoformat(str(value).strip())\n        except ValueError as exc:\n            raise ValueError(f\"{field_name}必须为有效的YYYY-MM-DD日期\") from exc\n\n    def default_process(kind, param, start, end):\n        if kind == \"annual\":\n            lines = [\n                f\"正在生成年度运输计划（{param}），请稍候...\",\n                f\"正在加载{param}年历史客流数据与线路基础信息...\",\n                \"分析全年客流趋势，识别季节性波动与节假日特征...\",\n                \"统计各线路高峰、平峰、低谷时段客流分布规律...\",\n                \"匹配线路运力资源，确定车辆编组与交路方案...\",\n                \"计算各时段发车间隔，优化列车运行图参数...\",\n                \"综合评估运力利用率与服务水平指标...\",\n                \"生成运输计划页面地址...\"\n            ]\n        elif kind == \"monthly\":\n            lines = [\n                f\"正在生成月度运输计划（{param}），请稍候...\",\n                f\"正在加载{param}月度客流预测数据...\",\n                \"分析当月工作日与节假日客流分布特征...\",\n                \"识别早晚高峰时段客流集中度与潮汐规律...\",\n                \"匹配月度运力资源，调整车辆检修与备用计划...\",\n                \"优化各日类型发车间隔与列车交路安排...\",\n                \"校验运营时间窗口与最小行车间隔约束...\",\n                \"生成运输计划页面地址...\"\n            ]\n        else:\n            lines = [\n                f\"正在生成区间运输计划（{start}至{end}），请稍候...\",\n                \"正在加载指定日期区间的客流预测与线路基础信息...\",\n                \"分析区间内工作日、周末与节假日分布特征...\",\n                \"识别各日高峰、平峰和低谷时段客流规律...\",\n                \"匹配区间运力资源与列车交路安排...\",\n                \"计算各日类型发车间隔与运营时间参数...\",\n                \"校验日期范围、运行图冲突与折返能力约束...\",\n                \"生成运输计划页面地址...\"\n            ]\n        return \"\\n\".join(lines)\n\n    try:\n        if not isinstance(is_valid, bool):\n            return failure(\"大模型输出is_valid类型错误\")\n        if not is_valid:\n            message = error_message.strip()\n            if not message:\n                message = \"未识别到完整的运输计划类型和日期\"\n            return failure(message)\n\n        normalized_type = plan_type.strip().lower()\n        normalized_param = plan_param.strip()\n        if normalized_type not in {\"annual\", \"monthly\", \"range\"}:\n            return failure(\"计划类型必须是annual、monthly或range\")\n\n        if normalized_type == \"annual\":\n            match = re.fullmatch(r\"(\\d{4})\", normalized_param)\n            if not match:\n                return failure(\"年度计划参数必须为YYYY\")\n            year = int(match.group(1))\n            normalized_start = date(year, 1, 1)\n            normalized_end = date(year, 12, 31)\n            query = urlencode({\"year\": f\"{year:04d}\"})\n            url = f\"/transport-plan/annual?{query}\"\n        elif normalized_type == \"monthly\":\n            match = re.fullmatch(r\"(\\d{4})-(\\d{2})\", normalized_param)\n            if not match:\n                return failure(\"月度计划参数必须为YYYY-MM\")\n            year, month = int(match.group(1)), int(match.group(2))\n            if month < 1 or month > 12:\n                return failure(\"月度计划月份必须在01至12之间\")\n            normalized_start = date(year, month, 1)\n            normalized_end = date(year, month, calendar.monthrange(year, month)[1])\n            query = urlencode({\n                \"start_date\": normalized_start.isoformat(),\n                \"end_date\": normalized_end.isoformat()\n            })\n            url = f\"/transport-plan/monthly?{query}\"\n        else:\n            normalized_start = parse_iso(start_date, \"start_date\")\n            normalized_end = parse_iso(end_date, \"end_date\")\n            if normalized_start > normalized_end:\n                return failure(\"开始日期不得晚于结束日期\")\n            normalized_param = f\"{normalized_start.isoformat()}~{normalized_end.isoformat()}\"\n            query = urlencode({\n                \"start_date\": normalized_start.isoformat(),\n                \"end_date\": normalized_end.isoformat()\n            })\n            url = f\"/transport-plan/monthly?{query}\"\n\n        if normalized_start < min_date or normalized_end > max_date:\n            return failure(\"日期范围必须在2023-01-01至2026-12-31之间\")\n\n        model_process = process_text.strip()\n        invalid_process = (\n            not model_process\n            or len(model_process) > 4000\n            or \"```\" in model_process\n            or \"http://\" in model_process.lower()\n            or \"https://\" in model_process.lower()\n            or \"/transport-plan/\" in model_process\n        )\n        if invalid_process:\n            model_process = default_process(\n                normalized_type,\n                normalized_param,\n                normalized_start.isoformat(),\n                normalized_end.isoformat()\n            )\n\n        answer = f\"{model_process}\\n运输计划地址：{url}\"\n        return {\n            \"answer\": answer,\n            \"url\": url,\n            \"plan_type\": normalized_type,\n            \"plan_param\": normalized_param,\n            \"start_date\": normalized_start.isoformat(),\n            \"end_date\": normalized_end.isoformat(),\n            \"workflow_status\": \"成功\",\n            \"error_msg\": \"\"\n        }\n    except Exception as exc:\n        return failure(str(exc))","title_en":"Code","about":"自定义函数和测试输入，并在后台提供一个沙箱协助用户执行代码。沙箱中需要管控好用户的权限，拒绝用户做删除系统文件等危险操作。目前仅支持python。","errorMessage":[],"selected":false,"payload__code_language":"python3","payload__variables":[{"variable":"plan_type","id":"874f7977-0405-506f-ba66-e082357b5cce","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_type","_id473e5f11-818c-52bc-87be-f02ed97ef2dd"],"is_constant":false,"value_selector":["5eae08d7-f410-5271-8614-9a8119f7a111","plan_type"]},{"variable":"plan_param","id":"d07565fa-8e92-5c53-a8de-2c5c0f6c0557","defaultBooleanValue":false,"variable_readonly":false,"type_readonly":true,"variable_allow_clear":false,"readonly":false,"type":"string","variable_channel":[